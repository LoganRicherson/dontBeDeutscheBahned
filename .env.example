# Deutsche Bahn API Marketplace credentials
DB_CLIENT_ID="your_db_client_id"
DB_API_KEY="your_db_api_key"

# Discord channel webhook (Server Settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# SQLite database, relative to the project root
DATABASE_URL="file:./prisma/dev.db"

# Minutes between polling cycles
CHECK_INTERVAL_MINUTES=2
